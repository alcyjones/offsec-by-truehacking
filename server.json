{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.truehacking/offsec-by-truehacking",
  "title": "OffSec by True Hacking",
  "description": "Pentest, CTI e segurança ofensiva — do terminal ou agente com uma CLI e servidor MCP. 40+ ferramentas: scanning, exploit, CTI, forensics, persistence, evasion, c2, cloud, wireless, brute force, OSINT.",
  "websiteUrl": "https://github.com/truehacking/offsec-by-truehacking",
  "repository": {
    "url": "https://github.com/truehacking/offsec-by-truehacking",
    "source": "github"
  },
  "version": "0.0.1",
  "tools": [
    { "name": "scan", "description": "Scan target (TCP SYN/Connect, ports, services)" },
    { "name": "scanShallow", "description": "Quick scan on common ports (22,80,443,8080,8443)" },
    { "name": "scanDeep", "description": "Deep scan on 1-65535 ports" },
    { "name": "pcap", "description": "Live capture with BPF filter (output PCAP file)" },
    { "name": "pcapLive", "description": "Long-running live capture (agent-run)" },
    { "name": "exploit", "description": "Execute payload/exploit against a target" },
    { "name": "metasploit", "description": "Run Metasploit (msfconsole-style modules, payloads, hosts)" },
    { "name": "payload", "description": "Run custom payload (reverse/binder/shell/meterpreter)" },
    { "name": "cveExploit", "description": "CVE-based exploit (look up, exploit, verify)" },
    { "name": "threatIntel", "description": "External threat intel (Shodan, VirusTotal, MITRE)" },
    { "name": "malwareAnalysis", "description": "Malware analysis (hash, YARA, PE, strings)" },
    { "name": "forensic", "description": "Forensic scan (data from local, YARA, memory)" },
    { "name": "listAgents", "description": "List active agents/sessions" },
    { "name": "agentInteract", "description": "Interact with agent (read/write/output)" },
    { "name": "killSession", "description": "Kill an agent/session" },
    { "name": "subnetScan", "description": "Subnet scan (ARP/ping + services)" },
    { "name": "command", "description": "Run a single command (generic shell)" },
    { "name": "fileOps", "description": "Read/write/transfer files" },
    { "name": "customPayload", "description": "Generate custom payload (reverse/binder/meterpreter)" },
    { "name": "kerberoast", "description": "Kerberoasting (Kerberos ticket extraction)" },
    { "name": "ntlmDump", "description": "NTLM credential dump (system/credential)" },
    { "name": "persistence", "description": "Create persistence (backdoor, keylogger, scheduled task)" },
    { "name": "keylogger", "description": "Keylogger (screenshot + keystroke capture)" },
    { "name": "persistenceSchedule", "description": "Persist via scheduled task/registry/cron" },
    { "name": "evasion", "description": "Encode/decode shellcode (XOR, ROT13, Base64, UDROP)" },
    { "name": "evasionSilent", "description": "Silent mode (reverse/shellcode/binder stealth)" },
    { "name": "evasionStealth", "description": "Network-level stealth (DNS tunnel, HTTPS)" },
    { "name": "reporting", "description": "Penetration report (findings, recommendations, CVSS)" },
    { "name": "reportWrite", "description": "Write report (PDF/HTML/Markdown)" },
    { "name": "c2", "description": "Create C2 (command-and-control channel)" },
    { "name": "c2Interact", "description": "Interact with C2 session (remote shell)" },
    { "name": "c2Kill", "description": "Kill (remove) a C2 session" },
    { "name": "privilegeEscalation", "description": "Privilege escalation (sudo, SUID, capabilities, kernel)" },
    { "name": "lateralMovement", "description": "Lateral movement (psExec, WMI, SSH, Pass-the-Hash)" },
    { "name": "exfiltration", "description": "Data exfiltration (DNS, HTTPS, ICMP tunnel)" },
    { "name": "wireless", "description": "Wi-Fi attack (deauth, PMKID, handshake)" },
    { "name": "cloud", "description": "Cloud exploitation (IAM, S3, GCP, Azure)" },
    { "name": "bruteForce", "description": "Brute force (SSH, RDP, FTP, SMB, HTTP password guessing)" },
    { "name": "misp", "description": "Connect to MISP (Import/export IOCs, indicators)" },
    { "name": "osint", "description": "OSINT (username, email, phone, social media lookup)" }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "offsec-by-truehacking",
      "version": "0.0.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}