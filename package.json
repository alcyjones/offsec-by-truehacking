{
  "name": "offsec-by-truehacking",
  "version": "0.0.1",
  "description": "OffSec — pentest, CTI e segurança ofensiva.",
  "type": "module",
  "private": true,
  "workspaces": ["src/*"],
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/main.ts",
    "build": "node scripts/run-exclusive.mjs artifacts turborepo build artifacts:skills --force",
    "test": "npm run test:with-build",
    "test:local": "node scripts/run-development-tests.mjs local",
    "check:fast": "turborepo typecheck lint:built format:check",
    "docs:generate": "node scripts/run-exclusive.mjs artifacts turborepo docs:generate"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.4.3",
    "ajv": "8.20.0",
    "cross-spawn": "7.0.6",
    "pino": "10.4.0",
    "incur": "0.6.0"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "vitest": "5.0.3",
    "typescript": "7.0.2",
    "@types/node": "26.6.4",
    "@types/cross-spawn": "6.0.6"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.16.0",
  "bin": {
    "offsec": "scripts/offsec.mjs",
    "offsec-mcp": "scripts/offsec.mjs"
  }
}
